generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Foliocrew: cada creadora es dueña de sus datos ───

model Creator {
  id                     String    @id @default(cuid())
  /// Subdominio: <slug>.foliocrew.pro
  slug                   String    @unique
  name                   String
  /// Dominio propio de la creadora (Fase 8), p. ej. "crisliaugc.com"
  customDomain           String?   @unique
  /// Cuándo se comprobó que el dominio propio apunta a Foliocrew (null = pendiente)
  customDomainVerifiedAt DateTime?
  /// Cuándo terminó (o saltó) el asistente de bienvenida; null = todavía no
  onboardedAt            DateTime?
  status                 String    @default("active") // "active" | "paused"
  /// Nota interna de quien administra Foliocrew (soporte). La persona no la ve.
  adminNote              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  hero              Hero?
  stats             Stat[]
  contentCards      ContentCard[]
  brands            Brand[]
  brandEvents       BrandEvent[]
  reviews           Review[]
  services          Service[]
  testimonials      Testimonial[]
  packages          Package[]
  faqItems          FaqItem[]
  contactMessages   ContactMessage[]
  users             AdminUser[]
  siteSettings      SiteSettings?
  socialAccounts    SocialAccount[]
  goals             Goal[]
  actionItems       ActionItem[]
  logEntries        LogEntry[]
  scheduledPosts    ScheduledPost[]
  followerSnapshots FollowerSnapshot[]
  aiUsage           AiUsage[]
}

model Hero {
  id                  String   @id @default(cuid())
  creatorId           String   @unique @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name                String
  location            String
  niche               String
  nicheEn             String?
  badgeLabel          String   @default("UGC Creator / Brand Reviews")
  badgeLabelEn        String?
  headlinePlain       String
  headlinePlainEn     String?
  headlineEmphasis    String
  headlineEmphasisEn  String?
  headlineSuffix      String   @default("")
  headlineSuffixEn    String?
  description         String   @default("")
  descriptionEn       String?
  photoUrl            String?
  photoUrlMobile      String?
  ctaPrimaryLabel     String
  ctaPrimaryLabelEn   String?
  ctaPrimaryHref      String
  ctaSecondaryLabel   String
  ctaSecondaryLabelEn String?
  ctaSecondaryHref    String
  updatedAt           DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label     String
  labelEn   String?
  value     String
  icon      String   @default("star")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([creatorId])
}

model ContentCard {
  id              String   @id @default(cuid())
  creatorId       String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type            String // "video" | "photo"
  platform        String // "tiktok" | "instagram" | "facebook"
  postUrl         String?
  videoUrl        String?
  photoUrl        String?
  thumbnailUrl    String?
  caption         String
  captionEn       String?
  category        String
  categoryEn      String?
  statPrimary     String?
  statPrimaryEn   String?
  statSecondary   String?
  statSecondaryEn String?
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  // Métricas (panel v2): manuales o sincronizadas desde la red conectada.
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  metricsSyncedAt  DateTime?
  showMetrics      Boolean   @default(true) // mostrarlas en el sitio público
  // "Lo que dicen": comentario destacado del público.
  topComment       String?
  topCommentEn     String?
  topCommentAuthor String?
  // Pieza destacada en la sección Colaboraciones de su marca.
  featured         Boolean   @default(false)
  // Cuándo se publicó en la red (lo trae la sincronización); alimenta "mejor hora para publicar".
  postedAt         DateTime?

  @@index([creatorId])
}

model Brand {
  id           String        @id @default(cuid())
  creatorId    String        @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name         String
  logoUrl      String?
  websiteUrl   String?
  order        Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contentCards ContentCard[]

  // CRM de colaboraciones (panel v2). dealStatus null = solo logo de portafolio, sin trato.
  dealStatus     String? // "prospect" | "negotiating" | "active" | "completed"
  contactName    String?
  contactEmail   String?
  dealValue      Int? // en USD, sin decimales
  packageDetail  String?
  platforms      String[]        @default([])
  paymentStatus  String? // "pending" | "paid"
  nextAction     String?
  nextActionDue  DateTime?
  lastContactAt  DateTime?
  notes          String?
  events         BrandEvent[]
  scheduledPosts ScheduledPost[]

  @@index([creatorId])
}

model BrandEvent {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())

  @@index([brandId, date])
  @@index([creatorId])
}

model Review {
  id            String   @id @default(cuid())
  creatorId     String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  photoUrl      String?
  category      String
  categoryEn    String?
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  rating        Int      @default(5)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([creatorId])
}

model Service {
  id            String  @id @default(cuid())
  creatorId     String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator       Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  icon          String  @default("camera")
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  order         Int     @default(0)

  @@index([creatorId])
}

model Testimonial {
  id        String  @id @default(cuid())
  creatorId String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  quote     String
  quoteEn   String?
  name      String
  role      String
  roleEn    String?
  photoUrl  String?
  order     Int     @default(0)

  @@index([creatorId])
}

model Package {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  emoji     String   @default("✨")
  name      String
  nameEn    String?
  items     String[]
  itemsEn   String[]
  order     Int      @default(0)

  @@index([creatorId])
}

model FaqItem {
  id         String  @id @default(cuid())
  creatorId  String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator    Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  question   String
  questionEn String?
  answer     String
  answerEn   String?
  order      Int     @default(0)

  @@index([creatorId])
}

model ContactMessage {
  id                String    @id @default(cuid())
  creatorId         String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator           Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name              String
  brand             String
  email             String
  collaborationType String
  message           String
  read              Boolean   @default(false)
  repliedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([creatorId])
}

model AdminUser {
  id              String      @id @default(cuid())
  name            String?
  role            String      @default("owner") // "owner" (más adelante: "editor" para agencias)
  creatorId       String      @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator         Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  email           String      @unique
  passwordHash    String
  /// Cuándo confirmó su correo con el enlace que le mandamos (null = sin confirmar)
  emailVerifiedAt DateTime?
  /// Sube al cambiar o restablecer la contraseña: cierra las sesiones abiertas en otros equipos
  sessionVersion  Int         @default(0)
  /// Último inicio de sesión (panel de dueño)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  tokens          AuthToken[]

  @@index([creatorId])
}

/// Enlaces de un solo uso que se mandan por correo (restablecer contraseña, confirmar correo).
/// Solo se guarda el hash del token: quien lea la base de datos no puede usarlos.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "reset" | "verify"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model SiteSettings {
  id               String   @id @default(cuid())
  creatorId        String   @unique @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  whyMeText        String
  whyMeTextEn      String?
  contactEmail     String
  instagramHandle  String
  tiktokHandle     String
  facebookHandle   String?
  whatsapp         String?
  collabsEmail     String?
  websiteUrl       String?
  youtubeHandle    String?
  pinterestHandle  String?
  footerIntro      String?
  footerIntroEn    String?
  supportMessage   String?
  supportMessageEn String?
  accentColor      String   @default("lila") // paleta de acento (lib/theme.ts)
  updatedAt        DateTime @updatedAt
}

// Cuentas de redes conectadas por OAuth (panel v2 → Conectar cuentas).
// Los tokens se guardan cifrados (lib/token-crypto.ts), nunca en texto plano.
model SocialAccount {
  id           String    @id @default(cuid())
  creatorId    String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform     String // "instagram" | "facebook" | "tiktok" | "youtube"
  externalId   String
  username     String?
  displayName  String?
  avatarUrl    String?
  followers    Int?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]  @default([])
  connectedAt  DateTime  @default(now())
  lastSyncAt   DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt

  @@unique([creatorId, platform])
}

// ─── Crecimiento (panel v2): metas, plan semanal y bitácora ───

model Goal {
  id        String    @id @default(cuid())
  creatorId String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  category  String    @default("content") // "content" | "audience" | "skill" | "habit"
  current   Float     @default(0)
  target    Float
  unit      String? // sufijo opcional para mostrar, ej. "K" o "videos"
  // De dónde sale el valor actual: "manual" o automático (seguidores de una red, publicaciones del mes).
  source    String    @default("manual")
  dueDate   DateTime?
  archived  Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([creatorId])
}

model ActionItem {
  id          String    @id @default(cuid())
  creatorId   String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label       String
  category    String    @default("content")
  weekStart   String // lunes de la semana, "YYYY-MM-DD" en la zona horaria de la app
  done        Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([weekStart])
  @@index([creatorId])
}

model LogEntry {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind      String // "milestone" | "learning" | "journal"
  date      String // "YYYY-MM-DD"
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())

  @@index([kind, date])
  @@index([creatorId])
}

// ─── Contenido (panel v2): publicaciones planeadas en Calendario / Crear ───

model ScheduledPost {
  id           String    @id @default(cuid())
  creatorId    String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption      String    @default("")
  topic        String? // tema usado para las sugerencias de IA
  contentType  String    @default("reel") // "post" | "carousel" | "reel" | "long_video" | "story"
  networks     String[]  @default([]) // "instagram" | "tiktok" | "youtube" | "facebook"
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  mediaUrl     String?
  mediaType    String? // "image" | "video"
  scheduledFor DateTime
  status       String    @default("scheduled") // "draft" | "scheduled" | "published"
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scheduledFor])
  @@index([creatorId])
}

// ─── Reportes (panel v2): historial de seguidores por red ───

model FollowerSnapshot {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform  String // "instagram" | "tiktok" | "youtube" | "facebook"
  date      String // "YYYY-MM-DD" en APP_TIMEZONE; uno por red y día
  followers Int
  source    String   @default("auto") // "auto" (cuenta conectada) | "manual"
  createdAt DateTime @default(now())

  @@unique([creatorId, platform, date])
}

// ─── Foliocrew: lista de espera de la plataforma (no pertenece a una creadora) ───

model WaitlistEntry {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  instagram   String?
  niche       String?
  /// "0-1k" | "1k-10k" | "10k-50k" | "50k+"
  audience    String?
  /// De dónde llegó (utm_source, utm_medium, utm_campaign) y quién la mandó
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  status      String    @default("waiting") // "waiting" | "invited"
  invitedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// Cada sugerencia de IA que pide una cuenta (para el panel de dueño y los límites por plan).
model AiUsage {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind         String // "caption" | "tips"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([creatorId, createdAt])
}

/// Acciones de quien administra la plataforma (pausar, reactivar, entrar como, notas).
model PlatformAction {
  id         String   @id @default(cuid())
  actorEmail String
  action     String // "pause" | "activate" | "impersonate" | "note"
  creatorId  String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
}
