generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Foliocrew: cada creadora es dueña de sus datos ───

model Creator {
  id                     String    @id @default(cuid())
  /// Subdominio: <slug>.foliocrew.pro
  slug                   String    @unique
  name                   String
  /// Dominio propio de la creadora (Fase 8), p. ej. "crisliaugc.com"
  customDomain           String?   @unique
  /// Cuándo se comprobó que el dominio propio apunta a Foliocrew (null = pendiente)
  customDomainVerifiedAt DateTime?
  /// Cuándo terminó (o saltó) el asistente de bienvenida; null = todavía no
  onboardedAt            DateTime?
  status                 String    @default("active") // "active" | "paused"
  /// Nota interna de quien administra Foliocrew (soporte). La persona no la ve.
  adminNote              String?
  /// Plan contratado: "folio" | "pro" | "crew" (lib/plans.ts)
  plan                   String    @default("pro")
  /// Cuenta de cortesía (fundadoras/es, amistades): no paga ni vence
  comp                   Boolean   @default(false)
  /// Embajadora de Foliocrew (nivel por invitación, docs/plan-embajadores.md): Folio Pro sin pagar y se puede quitar
  ambassador             Boolean   @default(false)
  /// "invited" | "earned"
  ambassadorSource       String?
  ambassadorSince        DateTime?
  /// Código del enlace foliocrew.pro/?ref=<código> (se crea al volverse embajadora; no cambia aunque cambie el slug)
  referralCode           String?   @unique
  /// Mostrar la insignia "Foliocrew Ambassador" en su sitio público
  ambassadorBadge        Boolean   @default(true)
  /// Fin de la prueba gratis (null = sin prueba)
  trialEndsAt            DateTime?
  /// Pagado hasta (pagos manuales por PayPal o transferencia)
  paidUntil              DateTime?
  /// Último recordatorio de pago enviado (evita mandarlo dos veces), p. ej. "trial-3:2026-10-17"
  billingReminder        String?
  /// Suma sus resultados, de forma anónima y agregada, a la inteligencia de Foliocrew (y recibe comparativas de su nicho)
  shareInsights          Boolean   @default(false)
  shareInsightsAt        DateTime?
  /// Cómo trabaja con marcas: "contenido" (publica en sus redes) | "ugc" (crea para que la marca publique) | "ambos"
  creatorKind            String    @default("contenido")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  hero                Hero?
  stats               Stat[]
  contentCards        ContentCard[]
  brands              Brand[]
  brandEvents         BrandEvent[]
  reviews             Review[]
  services            Service[]
  testimonials        Testimonial[]
  packages            Package[]
  faqItems            FaqItem[]
  contactMessages     ContactMessage[]
  users               AdminUser[]
  siteSettings        SiteSettings?
  socialAccounts      SocialAccount[]
  inboxReplies        InboxReply[]
  supportTickets      SupportTicket[]
  ideas               Idea[]
  dataRequests        DataRequest[]
  goals               Goal[]
  actionItems         ActionItem[]
  logEntries          LogEntry[]
  scheduledPosts      ScheduledPost[]
  followerSnapshots   FollowerSnapshot[]
  aiUsage             AiUsage[]
  bioLinks            BioLink[]
  bioLinkGroups       BioLinkGroup[]
  payments            Payment[]
  referralsAsReferrer Referral[]        @relation("referrer")
  referral            Referral?         @relation("referred")
  communityProfile    CommunityProfile?
  communityPosts      CommunityPost[]
  communityReplies    CommunityReply[]
  connectionsSent     CommunityConnection[]   @relation("ConnectionRequester")
  connectionsReceived CommunityConnection[]   @relation("ConnectionAddressee")
  conversationsA      CommunityConversation[] @relation("ConversationA")
  conversationsB      CommunityConversation[] @relation("ConversationB")
  deliverables        Deliverable[]
  invoices            Invoice[]
  billingProfile      BillingProfile?
  contracts           Contract[]
}

model Hero {
  id                  String   @id @default(cuid())
  creatorId           String   @unique @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name                String
  location            String
  niche               String
  nicheEn             String?
  badgeLabel          String   @default("UGC Creator / Brand Reviews")
  badgeLabelEn        String?
  headlinePlain       String
  headlinePlainEn     String?
  headlineEmphasis    String
  headlineEmphasisEn  String?
  headlineSuffix      String   @default("")
  headlineSuffixEn    String?
  description         String   @default("")
  descriptionEn       String?
  photoUrl            String?
  photoUrlMobile      String?
  ctaPrimaryLabel     String
  ctaPrimaryLabelEn   String?
  ctaPrimaryHref      String
  ctaSecondaryLabel   String
  ctaSecondaryLabelEn String?
  ctaSecondaryHref    String
  updatedAt           DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label     String
  labelEn   String?
  value     String
  icon      String   @default("star")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([creatorId])
}

model ContentCard {
  id              String   @id @default(cuid())
  creatorId       String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator         Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type            String // "video" | "photo"
  platform        String // "tiktok" | "instagram" | "facebook"
  postUrl         String?
  videoUrl        String?
  photoUrl        String?
  thumbnailUrl    String?
  caption         String
  captionEn       String?
  category        String
  categoryEn      String?
  statPrimary     String?
  statPrimaryEn   String?
  statSecondary   String?
  statSecondaryEn String?
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  // Métricas (panel v2): manuales o sincronizadas desde la red conectada.
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  metricsSyncedAt  DateTime?
  showMetrics      Boolean   @default(true) // mostrarlas en el sitio público
  // "Lo que dicen": comentario destacado del público.
  topComment       String?
  topCommentEn     String?
  topCommentAuthor String?
  // Pieza destacada en la sección Colaboraciones de su marca.
  featured         Boolean   @default(false)
  // Cuándo se publicó en la red (lo trae la sincronización); alimenta "mejor hora para publicar".
  postedAt         DateTime?

  @@index([creatorId])
}

model Brand {
  id           String        @id @default(cuid())
  creatorId    String        @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name         String
  logoUrl      String?
  websiteUrl   String?
  order        Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contentCards ContentCard[]

  // CRM de colaboraciones (panel v2). dealStatus null = solo logo de portafolio, sin trato.
  dealStatus     String? // "prospect" | "negotiating" | "active" | "completed"
  contactName    String?
  contactEmail   String?
  dealValue      Int? // en USD, sin decimales
  packageDetail  String?
  platforms      String[]        @default([])
  paymentStatus  String? // "pending" | "paid"
  nextAction     String?
  nextActionDue  DateTime?
  lastContactAt  DateTime?
  notes          String?
  events         BrandEvent[]
  scheduledPosts ScheduledPost[]
  deliverables   Deliverable[]
  invoices       Invoice[]
  contracts      Contract[]

  // Derechos de uso y exclusividad del trato (B2)
  /// Días que la marca puede usar el contenido en sus anuncios o redes
  usageRightsDays     Int?
  usageRightsStart    DateTime?
  exclusivityDays     Int?
  /// "Skincare", "bebidas"… (con quién no puede trabajar mientras dure)
  exclusivityCategory String?
  whitelisting        Boolean   @default(false)
  /// Último aviso de "tus derechos de uso vencen pronto" (para no repetirlo)
  usageReminderAt     DateTime?

  // Propuesta escrita con IA (C1): seguimiento a los 5 y 12 días si la marca no responde
  /// Cuándo se envió la propuesta (null = no hay propuesta en curso)
  pitchSentAt    DateTime?
  /// Seguimientos ya enviados (0, 1 o 2)
  pitchFollowUps Int       @default(0)
  /// Cuándo respondió la marca (deja de contar como «sin respuesta»)
  pitchRepliedAt DateTime?
  /// Lo que se le ofreció (para escribir los seguimientos con el mismo hilo)
  pitchOffer     String?

  @@index([creatorId])
}

/// Lo que hay que entregarle a una marca en un trato (un reel, un set de fotos…).
model Deliverable {
  id         String    @id @default(cuid())
  creatorId  String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator    Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// "Reel de 30 s con el producto"
  title      String
  /// instagram | tiktok | youtube | facebook | ugc | otro
  network    String?
  dueAt      DateTime?
  /// todo | draft | in_review | approved | published (lib/deliverables.ts)
  status     String    @default("todo")
  /// Enlace a la publicación o al archivo entregado
  proofUrl   String?
  order      Int       @default(0)
  /// Último aviso de "vence en 2 días" (se borra si cambia la fecha)
  remindedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([creatorId])
  @@index([brandId])
}

/// Datos con los que el creador factura (B3). Nunca SSN/ITIN ni números de cuenta completos.
model BillingProfile {
  id             String   @id @default(cuid())
  creatorId      String   @unique @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  /// Nombre legal o artístico que va en la factura
  legalName      String   @default("")
  /// "Miami, FL, EE. UU."
  location       String   @default("")
  /// Correo que ve la marca en la factura
  email          String   @default("")
  /// Cómo pagar: "PayPal: tu@correo · Zelle: …" (lo que el creador decida mostrar)
  payTo          String   @default("")
  /// Plazo de pago por defecto en días
  termsDays      Int      @default(15)
  depositPercent Int      @default(50)
  invoicePrefix  String   @default("FC")
  /// Consecutivo de la próxima factura
  nextNumber     Int      @default(1)
  /// Nota por defecto al pie de la factura
  defaultNotes   String   @default("")
  updatedAt      DateTime @updatedAt
}

/// Factura a una marca (B3). La marca la ve en /f/<publicToken> sin iniciar sesión.
model Invoice {
  id                String    @id @default(cuid())
  creatorId         String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator           Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brandId           String?
  brand             Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// "FC-2026-0007", consecutivo por cuenta
  number            String
  /// 32 bytes aleatorios en base64url: el enlace que recibe la marca
  publicToken       String    @unique
  /// full | deposit | balance (completa, anticipo, saldo)
  kind              String    @default("full")
  currency          String    @default("USD")
  /// [{ description, quantity, unitAmount }] con montos en centavos
  items             Json
  /// Total en centavos
  subtotal          Int
  notes             String    @default("")
  payTo             String
  /// { name, company, email }
  billTo            Json
  /// Datos del creador al momento de facturar: { name, location, email }
  issuer            Json
  /// es | en
  language          String    @default("es")
  issuedAt          DateTime  @default(now())
  dueAt             DateTime
  /// draft | sent | paid | void ("vista" y "vencida" se calculan con viewedAt y dueAt)
  status            String    @default("draft")
  sentAt            DateTime?
  viewedAt          DateTime?
  paidAt            DateTime?
  /// La marca tocó "Ya pagamos" (el creador lo confirma)
  claimedPaidAt     DateTime?
  lastReminderAt    DateTime?
  remindersSent     Int       @default(0)
  /// Ya se avisó al creador que venció (una vez)
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creatorId])
  @@index([brandId])
  @@index([status, dueAt])
}

/// Contrato simple con una marca (B4). La marca lo lee y lo acepta en /c/<publicToken> sin iniciar sesión.
/// Una vez aceptado no se puede cambiar: bodyHash prueba qué texto se aceptó.
model Contract {
  id                String    @id @default(cuid())
  creatorId         String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator           Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brandId           String?
  brand             Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// 32 bytes aleatorios en base64url: el enlace que recibe la marca
  publicToken       String    @unique
  /// sponsored | ugc | ambassador | affiliate (lib/contracts.ts)
  template          String
  /// es | en
  language          String    @default("es")
  title             String
  /// Los huecos que llenó el creador (lib/contracts.ts → ContractTerms)
  terms             Json
  /// { creator: { name, location, email }, brand: { company, name, email } }
  parties           Json
  /// Texto final generado a partir de terms y parties (## Título, párrafos y "- " para listas)
  bodyText          String
  /// draft | sent | accepted | declined
  status            String    @default("draft")
  sentAt            DateTime?
  viewedAt          DateTime?
  acceptedName      String?
  acceptedEmail     String?
  acceptedAt        DateTime?
  acceptedIp        String?
  acceptedUserAgent String?
  /// SHA-256 del texto aceptado
  bodyHash          String?
  declinedAt        DateTime?
  declineReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creatorId])
  @@index([brandId])
}

model BrandEvent {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())

  @@index([brandId, date])
  @@index([creatorId])
}

model Review {
  id            String   @id @default(cuid())
  creatorId     String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  photoUrl      String?
  category      String
  categoryEn    String?
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  rating        Int      @default(5)
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([creatorId])
}

model Service {
  id            String  @id @default(cuid())
  creatorId     String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator       Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  icon          String  @default("camera")
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  order         Int     @default(0)

  @@index([creatorId])
}

model Testimonial {
  id        String  @id @default(cuid())
  creatorId String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  quote     String
  quoteEn   String?
  name      String
  role      String
  roleEn    String?
  photoUrl  String?
  order     Int     @default(0)

  @@index([creatorId])
}

model Package {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  emoji     String   @default("✨")
  name      String
  nameEn    String?
  items     String[]
  itemsEn   String[]
  order     Int      @default(0)
  /// Precio «desde» en dólares, sin decimales (null = no se muestra precio)
  priceFrom Int?
  currency  String   @default("USD")
  /// Las marcas pueden solicitar este paquete desde el sitio público (C2). Los paquetes que ya existían quedan apagados.
  requestable Boolean @default(false)

  @@index([creatorId])
}

model FaqItem {
  id         String  @id @default(cuid())
  creatorId  String  @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator    Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  question   String
  questionEn String?
  answer     String
  answerEn   String?
  order      Int     @default(0)

  @@index([creatorId])
}

model ContactMessage {
  id                String    @id @default(cuid())
  creatorId         String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator           Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name              String
  brand             String
  email             String
  collaborationType String
  message           String
  read              Boolean   @default(false)
  repliedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([creatorId])
}

model AdminUser {
  id              String      @id @default(cuid())
  name            String?
  role            String      @default("owner") // "owner" (más adelante: "editor" para agencias)
  creatorId       String      @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator         Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  email           String      @unique
  passwordHash    String
  /// Cuándo confirmó su correo con el enlace que le mandamos (null = sin confirmar)
  emailVerifiedAt DateTime?
  /// Sube al cambiar o restablecer la contraseña: cierra las sesiones abiertas en otros equipos
  sessionVersion  Int         @default(0)
  /// Último inicio de sesión (panel de dueño)
  lastLoginAt     DateTime?
  /// Idioma del panel y de los correos: "es" | "en"
  language        String      @default("es")
  createdAt       DateTime    @default(now())
  tokens          AuthToken[]

  @@index([creatorId])
}

/// Enlaces de un solo uso que se mandan por correo (restablecer contraseña, confirmar correo).
/// Solo se guarda el hash del token: quien lea la base de datos no puede usarlos.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "reset" | "verify"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model SiteSettings {
  id                 String   @id @default(cuid())
  creatorId          String   @unique @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator            Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  whyMeText          String
  whyMeTextEn        String?
  contactEmail       String
  instagramHandle    String
  tiktokHandle       String
  facebookHandle     String?
  whatsapp           String?
  collabsEmail       String?
  websiteUrl         String?
  youtubeHandle      String?
  pinterestHandle    String?
  footerIntro        String?
  footerIntroEn      String?
  supportMessage     String?
  supportMessageEn   String?
  accentColor        String   @default("lila") // paleta de acento (lib/theme.ts) o "custom"
  // Estudio de diseño (lib/design.ts): solo opciones cerradas, validadas al leer.
  customAccent       String? // color propio "#RRGGBB" cuando accentColor = "custom"
  themeStyle         String   @default("editorial")
  fontPair           String   @default("editorial")
  heroLayout         String   @default("split")
  corners            String   @default("suave")
  background         String   @default("textura")
  sectionLayout      Json? // [{ id, hidden }] en el orden en que se muestran
  secondaryColor     String   @default("acento") // bloques y botones oscuros: acento, oliva, tinta o estilo
  contactPhotoUrl    String? // foto de la sección de contacto (vacía: sin foto)
  brandsBannerUrl    String? // imagen sobre la cinta de marcas (vacía: sin imagen)
  // Link en bio (/enlaces)
  linksTagline       String? // frase bajo el nombre: "Mis favoritos y más ✨"
  linksTaglineEn     String?
  linksPattern       String   @default("blobs") // fondo: blobs, punteado, petalos, ramitas, enredadera
  linksShowBrandKit  Boolean  @default(true) // bloque automático: media kit, contacto, WhatsApp, correo
  linksShowRecent    Boolean  @default(true) // bloque automático: contenido reciente del Feed
  linksShowCopy      Boolean  @default(true) // botón "Copiar mi enlace"
  linksShowSocials   Boolean  @default(true) // fila de íconos de redes
  linksHeroShow      Boolean  @default(true) // tarjeta principal (hacia el portafolio)
  linksHeroEyebrow   String?
  linksHeroEyebrowEn String?
  linksHeroTitle     String?
  linksHeroTitleEn   String?
  linksHeroImage     String? // vacía: la foto de la portada
  linksHeroUrl       String? // vacía: el portafolio
  updatedAt          DateTime @updatedAt
}

// Cuentas de redes conectadas por OAuth (panel v2 → Conectar cuentas).
// Los tokens se guardan cifrados (lib/token-crypto.ts), nunca en texto plano.
model SocialAccount {
  id           String    @id @default(cuid())
  creatorId    String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform     String // "instagram" | "facebook" | "tiktok" | "youtube"
  externalId   String
  /// Id de la persona para esta app (Meta: lo manda al desconectar o pedir borrar datos)
  scopedId     String?
  username     String?
  displayName  String?
  avatarUrl    String?
  followers    Int?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]  @default([])
  connectedAt  DateTime  @default(now())
  lastSyncAt   DateTime?
  lastError    String?
  updatedAt    DateTime  @updatedAt

  @@unique([creatorId, platform])
}

/// Respuestas enviadas desde la Bandeja. Meta no dice quién escribió una respuesta, así que se
/// guardan sus ids para reconocer las propias (y marcar el comentario como respondido).
model InboxReply {
  id        String   @id // id de la respuesta en la red
  creatorId String   @default("")
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform  String // "instagram"
  commentId String
  createdAt DateTime @default(now())

  @@index([creatorId, platform])
}

// ─── Crecimiento (panel v2): metas, plan semanal y bitácora ───

model Goal {
  id        String    @id @default(cuid())
  creatorId String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  category  String    @default("content") // "content" | "audience" | "skill" | "habit"
  current   Float     @default(0)
  target    Float
  unit      String? // sufijo opcional para mostrar, ej. "K" o "videos"
  // De dónde sale el valor actual: "manual" o automático (seguidores de una red, publicaciones del mes).
  source    String    @default("manual")
  dueDate   DateTime?
  archived  Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([creatorId])
}

model ActionItem {
  id          String    @id @default(cuid())
  creatorId   String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label       String
  category    String    @default("content")
  weekStart   String // lunes de la semana, "YYYY-MM-DD" en la zona horaria de la app
  done        Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([weekStart])
  @@index([creatorId])
}

model LogEntry {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind      String // "milestone" | "learning" | "journal"
  date      String // "YYYY-MM-DD"
  title     String
  body      String   @default("")
  createdAt DateTime @default(now())

  @@index([kind, date])
  @@index([creatorId])
}

// ─── Contenido (panel v2): publicaciones planeadas en Calendario / Crear ───

model ScheduledPost {
  id           String    @id @default(cuid())
  creatorId    String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator      Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption      String    @default("")
  topic        String? // tema usado para las sugerencias de IA
  contentType  String    @default("reel") // "post" | "carousel" | "reel" | "long_video" | "story"
  networks     String[]  @default([]) // "instagram" | "tiktok" | "youtube" | "facebook"
  brandId      String?
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  mediaUrl     String?
  mediaType    String? // "image" | "video"
  scheduledFor DateTime
  status       String    @default("scheduled") // "draft" | "scheduled" | "published"
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scheduledFor])
  @@index([creatorId])
}

// ─── Reportes (panel v2): historial de seguidores por red ───

model FollowerSnapshot {
  id        String   @id @default(cuid())
  creatorId String   @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  platform  String // "instagram" | "tiktok" | "youtube" | "facebook"
  date      String // "YYYY-MM-DD" en APP_TIMEZONE; uno por red y día
  followers Int
  source    String   @default("auto") // "auto" (cuenta conectada) | "manual"
  createdAt DateTime @default(now())

  @@unique([creatorId, platform, date])
}

// ─── Foliocrew: lista de espera de la plataforma (no pertenece a una creadora) ───

model WaitlistEntry {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  instagram   String?
  niche       String?
  /// "0-1k" | "1k-10k" | "10k-50k" | "50k+"
  audience    String?
  /// De dónde llegó (utm_source, utm_medium, utm_campaign) y quién la mandó
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  status      String    @default("waiting") // "waiting" | "invited"
  /// Idioma de la página cuando se anotó ("es" | "en"): los correos le llegan en ese idioma
  language    String    @default("es")
  invitedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// Cada sugerencia de IA que pide una cuenta (para el panel de dueño y los límites por plan).
model AiUsage {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind         String // "caption" | "tips" | "design" | "pitch"
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([creatorId, createdAt])
}

/// Acciones de quien administra la plataforma (pausar, reactivar, entrar como, notas).
model PlatformAction {
  id         String   @id @default(cuid())
  actorEmail String
  action     String // "pause" | "activate" | "impersonate" | "note"
  creatorId  String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([creatorId, createdAt])
}

/// Solicitudes de borrado de datos que manda Meta (callback de "Eliminación de datos").
model DataDeletionRequest {
  id              String   @id @default(cuid())
  code            String   @unique
  platform        String
  externalId      String
  deletedAccounts Int      @default(0)
  createdAt       DateTime @default(now())
}

/// Pagos manuales (PayPal o transferencia). La persona los reporta y quien administra los confirma.
model Payment {
  id          String    @id @default(cuid())
  creatorId   String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  plan        String
  months      Int       @default(1)
  amountCents Int
  currency    String    @default("USD")
  method      String // "paypal" | "transfer" | "other"
  reference   String?
  note        String?
  status      String    @default("reported") // "reported" | "confirmed" | "rejected"
  periodEnd   DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([creatorId, createdAt])
  @@index([status])
}

/// Lo que aprende Foliocrew de cada nicho (agregado y anónimo, solo de cuentas que aceptaron participar).
model NicheInsight {
  id          String   @id @default(cuid())
  /// Id del nicho (lib/onboarding.ts) o "global"
  niche       String   @unique
  label       String
  creators    Int
  posts       Int
  /// Medianas, mejores franjas, formatos, redes y precios
  stats       Json
  /// Lo que escribe Claude: qué funciona, qué no, ganchos y recomendaciones
  playbook    Json?
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Enlaces propios de la página "link en bio" (/enlaces): tienda, cupones, videos, lo que quiera.
model BioLink {
  id        String        @id @default(cuid())
  creatorId String        @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title     String
  titleEn   String?
  url       String
  imageUrl  String?
  pill      String? // etiqueta corta arriba a la derecha: "15% OFF", "Nuevo"…
  wide      Boolean       @default(true) // fila a todo el ancho (true) o tarjeta con imagen (false)
  section   String        @default("") // grupo donde aparece ("Colabora conmigo", "Mis favoritos"…)
  sectionEn String?
  kicker    String? // palabra de acción sobre el título de la tarjeta: "Comprar", "Únete"
  kickerEn  String?
  badge     String? // etiqueta destacada en el acento: "Abierto ahora"
  badgeEn   String?
  clicks    Int           @default(0) // clics en la página pública (el más visitado lleva "Más clics")
  hidden    Boolean       @default(false) // pausado: no se muestra pero no se borra
  groupId   String?
  group     BioLinkGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  order     Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([creatorId])
}

// Bloques del link en bio, en orden: grupos propios ("Colabora conmigo"…) y los automáticos
// ("brandkit": media kit y contacto; "recent": contenido del Feed).
model BioLinkGroup {
  id        String    @id @default(cuid())
  creatorId String    @default("") // lo llena lib/prisma.ts; "" rompe la FK a propósito
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind      String    @default("custom") // "custom" | "brandkit" | "recent"
  title     String    @default("")
  titleEn   String?
  hidden    Boolean   @default(false)
  order     Int       @default(0)
  links     BioLink[]
  createdAt DateTime  @default(now())

  @@index([creatorId])
}

// ─── Equipo de Foliocrew: soporte, mejora continua y datos ───

/// Personas del equipo (además de PLATFORM_ADMIN_EMAILS, que son Dueño). Entran con su propia cuenta de Foliocrew.
model TeamMember {
  id        String   @id @default(cuid())
  /// Correo de su cuenta de Foliocrew (en minúsculas)
  email     String   @unique
  name      String?
  /// "support" | "growth" | "data" (lib/team.ts)
  roles     String[] @default([])
  active    Boolean  @default(true)
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Ticket del centro de soporte: lo abre una cuenta, lo atiende el equipo.
model SupportTicket {
  id               String           @id @default(cuid())
  number           Int              @unique @default(autoincrement())
  creatorId        String           @default("") // lo llena lib/prisma.ts
  creator          Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  authorEmail      String
  authorName       String?
  subject          String
  category         String           @default("otro") // lib/support.ts → CATEGORIES
  status           String           @default("open") // "open" | "waiting" | "closed"
  /// Correo de quien del equipo lo atiende
  assignedTo       String?
  /// La última respuesta del equipo todavía no la vio la cuenta
  unreadByCustomer Boolean          @default(false)
  lastActivityAt   DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  messages         SupportMessage[]

  @@index([status, lastActivityAt])
  @@index([creatorId])
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromTeam    Boolean       @default(false)
  /// Nota interna del equipo: la cuenta no la ve
  internal    Boolean       @default(false)
  authorEmail String
  authorName  String?
  body        String
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Centro de mejora continua: sugerencias de las cuentas e ideas internas del equipo.
model Idea {
  id           String   @id @default(cuid())
  /// Cuenta que la sugirió; null = idea interna del equipo
  creatorId    String?
  creator      Creator? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  authorEmail  String
  authorName   String?
  title        String
  description  String   @default("")
  category     String   @default("otro") // lib/ideas.ts → CATEGORIES
  status       String   @default("new") // "new" | "review" | "planned" | "done" | "declined"
  /// Respuesta del equipo que ve quien la sugirió
  teamReply    String?
  /// Nota interna del equipo
  internalNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([creatorId])
}

/// Centro de datos: pedidos de copia, recuperación o borrado de datos de una cuenta.
model DataRequest {
  id          String    @id @default(cuid())
  creatorId   String    @default("") // lo llena lib/prisma.ts
  creator     Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  kind        String // "export" | "recover" | "delete"
  detail      String    @default("")
  status      String    @default("open") // "open" | "done" | "rejected"
  requestedBy String
  handledBy   String?
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([creatorId])
}

// ─── Comunidad Foliocrew (entre cuentas: estos modelos NO van en TENANT_MODELS) ───

/// Perfil de comunidad de una cuenta (1 por cuenta). Se arma con los datos de Foliocrew.
model CommunityProfile {
  id              String           @id @default(cuid())
  creatorId       String           @unique
  creator         Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  displayName     String
  /// "Creo videos de cocina saludable en TikTok"
  headline        String           @default("")
  bio             String           @default("")
  avatarUrl       String?
  city            String?
  showCity        Boolean          @default(true)
  showSite        Boolean          @default(true)
  /// lib/community.ts → CREATOR_TYPES
  creatorTypes    String[]         @default([])
  /// id de lib/onboarding.ts → NICHES
  niche           String?
  languages       String[]         @default(["es"])
  openToCollab    Boolean          @default(false)
  reputation      Int              @default(0)
  /// Moderación: la cuenta no puede publicar ni responder hasta esta fecha
  mutedUntil      DateTime?
  acceptedRulesAt DateTime?
  /// Avisos por correo cuando responden o eligen su respuesta como la mejor
  emailNotify     Boolean          @default(true)
  /// Última visita al muro (para el contador de respuestas nuevas en el menú)
  lastSeenAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  posts           CommunityPost[]
  replies         CommunityReply[]

  @@index([niche])
}

model CommunityPost {
  id             String           @id @default(cuid())
  creatorId      String
  creator        Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  profileId      String
  profile        CommunityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// "pregunta" | "consejo" | "logro" | "colaboracion" | "recurso"
  kind           String
  topic          String           @default("otro")
  title          String
  body           String
  /// Versión en inglés (la usan las publicaciones del equipo, como la pregunta de la semana)
  titleEn        String?
  bodyEn         String?
  imageUrl       String?
  /// A qué tipo de creador va dirigido (para filtrar)
  creatorTypes   String[]         @default([])
  helpfulCount   Int              @default(0)
  replyCount     Int              @default(0)
  bestReplyId    String?
  /// El equipo fija la pregunta de la semana
  pinned         Boolean          @default(false)
  fromTeam       Boolean          @default(false)
  /// Oculto por moderación
  hiddenAt       DateTime?
  hiddenBy       String?
  /// Borrado por el autor
  deletedAt      DateTime?
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  replies        CommunityReply[]

  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([kind, topic])
  @@index([creatorId])
}

model CommunityReply {
  id           String           @id @default(cuid())
  postId       String
  post         CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  creatorId    String
  creator      Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  profileId    String
  profile      CommunityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  body         String
  helpfulCount Int              @default(0)
  hiddenAt     DateTime?
  hiddenBy     String?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([postId, createdAt])
  @@index([creatorId])
}

/// "Me sirvió": una por cuenta y por publicación o respuesta.
model CommunityReaction {
  id         String   @id @default(cuid())
  creatorId  String
  /// "post" | "reply"
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([creatorId, targetType, targetId])
  @@index([targetType, targetId])
}

model CommunityReport {
  id         String    @id @default(cuid())
  /// creatorId de quien reporta
  reporterId String
  /// "post" | "reply" | "profile"
  targetType String
  targetId   String
  /// "spam" | "ofensivo" | "estafa" | "otro"
  reason     String
  detail     String    @default("")
  /// "open" | "actioned" | "dismissed"
  status     String    @default("open")
  handledBy  String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

/// Conexión entre dos cuentas (como LinkedIn). Una sola fila por par: se valida en el código.
model CommunityConnection {
  id          String    @id @default(cuid())
  requesterId String
  requester   Creator   @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   Creator   @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  /// "pending" | "accepted" | "declined" (rechazar es silencioso: quien pidió sigue viendo "enviada")
  status      String    @default("pending")
  /// Mensaje corto opcional con la solicitud
  note        String    @default("")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Conversación privada entre dos conexiones. aId < bId (par ordenado) para que haya una sola por par.
model CommunityConversation {
  id            String             @id @default(cuid())
  aId           String
  a             Creator            @relation("ConversationA", fields: [aId], references: [id], onDelete: Cascade)
  bId           String
  b             Creator            @relation("ConversationB", fields: [bId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime           @default(now())
  lastSenderId  String?
  /// Hasta cuándo leyó cada lado (para los no leídos)
  aReadAt       DateTime?
  bReadAt       DateTime?
  createdAt     DateTime           @default(now())
  messages      CommunityMessage[]

  @@unique([aId, bId])
  @@index([aId, lastMessageAt])
  @@index([bId, lastMessageAt])
}

model CommunityMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// creatorId de quien envía
  senderId       String
  body           String
  /// Oculto por el equipo de Comunidad tras un reporte
  hiddenAt       DateTime?
  hiddenBy       String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model CommunityBlock {
  id        String   @id @default(cuid())
  /// creatorId de quien bloquea
  blockerId String
  /// creatorId bloqueado
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Programa de embajadoras: quién trajo a quién. No es por creadora (cruza cuentas): se usa prismaRoot.
model Referral {
  id           String    @id @default(cuid())
  referrerId   String
  referrer     Creator   @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  /// Una cuenta solo puede ser referida una vez
  referredId   String    @unique
  referred     Creator   @relation("referred", fields: [referredId], references: [id], onDelete: Cascade)
  /// signed_up | paid | rewarded | churned
  status       String    @default("signed_up")
  /// Primer pago confirmado
  paidAt       DateTime?
  rewardedAt   DateTime?
  rewardMonths Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([referrerId, status])
}
