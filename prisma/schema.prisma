generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hero {
  id                String   @id @default(cuid())
  name              String
  location          String
  niche             String
  badgeLabel        String   @default("UGC Creator / Brand Reviews")
  headlinePlain     String
  headlineEmphasis  String
  headlineSuffix    String   @default("")
  description       String   @default("")
  photoUrl          String?
  photoUrlMobile    String?
  ctaPrimaryLabel   String
  ctaPrimaryHref    String
  ctaSecondaryLabel String
  ctaSecondaryHref  String
  updatedAt         DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String   @default("star")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContentCard {
  id            String   @id @default(cuid())
  type          String // "video" | "photo"
  platform      String // "tiktok" | "instagram" | "facebook"
  postUrl       String
  caption       String
  category      String
  statPrimary   String?
  statSecondary String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model PricingPackage {
  id           String   @id @default(cuid())
  name         String
  price        String
  unit         String
  deliverables String[]
  featured     Boolean  @default(false)
  order        Int      @default(0)
}

model Brand {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String?
  websiteUrl String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  photoUrl    String?
  category    String
  title       String
  description String
  rating      Int      @default(5)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Service {
  id          String @id @default(cuid())
  icon        String @default("camera")
  title       String
  description String
  order       Int    @default(0)
}

model Testimonial {
  id       String @id @default(cuid())
  quote    String
  name     String
  role     String
  photoUrl String?
  order    Int    @default(0)
}

model FaqItem {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model ContactMessage {
  id                String   @id @default(cuid())
  name              String
  brand             String
  email             String
  collaborationType String
  message           String
  read              Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id              String   @id @default(cuid())
  whyMeText       String
  contactEmail    String
  instagramHandle String
  tiktokHandle    String
  facebookHandle  String?
  whatsapp        String?
  collabsEmail    String?
  websiteUrl      String?
  youtubeHandle   String?
  pinterestHandle String?
  footerIntro     String?
  supportMessage  String?
  updatedAt       DateTime @updatedAt
}
