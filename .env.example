# Postgres connection string (Vercel Postgres, Neon, or `npx create-db`)
DATABASE_URL=""

# Direct (non-pooled) Postgres connection string, used only for `prisma migrate deploy`.
# Required when DATABASE_URL points to a pooled/PgBouncer connection (e.g. Neon's "-pooler"
# host) — session-level advisory locks used by migrations aren't reliable through a pooler.
# On Neon: same as DATABASE_URL but with the "-pooler" host suffix removed.
DIRECT_URL=""

# Cuenta original del panel (antes de Foliocrew). La primera vez que entra se guarda en la
# base como dueña de la creadora DEFAULT_CREATOR_SLUG; después ya no hacen falta.
# Admin login — generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# Next.js expands $VAR in .env files, so escape every "$" in the hash as "\$"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# Random secret used to sign the admin session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Resend API key for the contact form (leave empty to keep email sending as a TODO)
RESEND_API_KEY=""

# Facebook JS SDK app id, needed to embed Facebook video/post content
NEXT_PUBLIC_FB_APP_ID=""

# Vercel Blob token, needed for image/video uploads (feed, hero photo, brand logos).
# Must point to a Blob store created with public access — the app always uploads
# with access: "public" since these files are shown on the public site.
PUBLIC_BLOB_READ_WRITE_TOKEN=""

# ─── Conectar cuentas (panel → Negocio → Conectar cuentas). Guía: docs/conectar-cuentas.md ───

# Encrypts the social network tokens stored in the database (required to connect any network).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Don't change it once accounts are connected: saved tokens could no longer be decrypted.
TOKEN_ENCRYPTION_KEY=""

# Platform name and legal contact shown on /privacidad, /terminos and /eliminar-datos
# (required pages for Meta, TikTok and Google app review). Defaults: "Foliocrew" and lib/creator-info.ts.
PLATFORM_NAME=""
LEGAL_OWNER_NAME=""
LEGAL_CONTACT_EMAIL=""

# Time zone used for weekly plans and activity streaks (IANA name). Default: America/New_York
APP_TIMEZONE=""

# Fixed public URL of the site, used to build the OAuth redirect URLs (no trailing slash).
# e.g. https://portafolio-cristal.vercel.app — must match what's registered in each developer console.
APP_URL=""

# Instagram API with Instagram Login (Meta app → Instagram → API setup with Instagram login).
# These are the *Instagram* app id/secret, not the Meta app id.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Facebook Login for Business (same Meta app → App settings → Basic). FACEBOOK_CONFIG_ID is the
# Facebook Login for Business configuration id (optional; without it the scopes are requested directly).
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CONFIG_ID=""

# TikTok Login Kit (developers.tiktok.com → your app → Client key / Client secret)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube: Google Cloud OAuth client (Web application) with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Claude API key for AI caption suggestions (platform.claude.com → API keys)
ANTHROPIC_API_KEY=""

# OpenAI key, only for `npm run brand:images` (brand images with DALL·E / gpt-image, see docs/marca.md).
# The app itself never uses it. Optional: OPENAI_IMAGE_MODEL (default gpt-image-1; e.g. dall-e-3).
OPENAI_API_KEY=""

# ─── Foliocrew multiusuario ───
# Dominio raíz de la plataforma: cada creadora tiene su sitio en <slug>.<dominio> y la raíz muestra la portada
# de Foliocrew. Déjalo VACÍO hasta que el dominio y el comodín (*.foliocrew.app) estén en Vercel: mientras tanto
# cada sitio se ve en <app>/s/<slug>. En local: "localhost:3000" (abre vic.localhost:3000). Ver docs/dominios.md.
PLATFORM_ROOT_DOMAIN=""
# Creadora que se muestra en cualquier otro dominio (p. ej. portafolio-cristal.vercel.app). Por defecto: "cristal".
DEFAULT_CREATOR_SLUG="cristal"
# Código para crear cuentas en /admin/registro. Si está vacío, el registro está CERRADO.
SIGNUP_INVITE_CODE=""
# Dominios propios de las creadoras: con esto Foliocrew los agrega y verifica solo en Vercel (ver docs/dominios.md).
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
